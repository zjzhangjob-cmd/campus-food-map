# ── 数据库（本地默认 SQLite，无需安装数据库）────────────────────────
# 相对路径会在 backend 目录下解析为 backend/campus_food.db
DATABASE_URL=sqlite:///./campus_food.db

# ── JWT 认证 ──────────────────────────────────────────────────
SECRET_KEY=campus-food-map-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── AI 推荐（Anthropic Claude）────────────────────────────────
# 申请：https://console.anthropic.com  不填则退化为规则推荐
ANTHROPIC_API_KEY=

# ── 高德地图 Key（启动脚本会自动读入并注入前端）───────────────────
# 申请：https://console.amap.com → 创建应用 → 「Web服务」和「JS API」
# Web 服务 Key（后端使用）
AMAP_KEY=
# JS API Key（前端地图使用；通过 /api/config 动态获取，无需手动替换 HTML）
AMAP_JS_KEY=

# ── 其他 ─────────────────────────────────────────────────────
APP_NAME=觅食·大学城美食地图
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
